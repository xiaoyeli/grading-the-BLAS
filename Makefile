# Directories
SRC_DIR := src
INC_DIR := include
LIB_DIR := lib
BIN_DIR := bin

# Flags
CXXFLAGS := -O0 -I$(INC_DIR) 
LDFLAGS :=

# Compiler
ifneq ($(or $(findstring OZIMMU,$(DGEMM_IMPL)),$(findstring CUBLAS,$(DGEMM_IMPL))),)
    CXX := nvcc
else
    CXX := g++
endif

ifneq ($(MIN_DIM),)
	CXXFLAGS += -DMIN_DIM=$(MIN_DIM)
endif

ifneq ($(MAX_DIM),)
	CXXFLAGS += -DMAX_DIM=$(MAX_DIM)
endif

ifneq ($(INPUT_TYPE),)
	CXXFLAGS += -DINPUT_TYPE=\"$(INPUT_TYPE)\"
endif

# Verbosity
ifeq ($(VERBOSE),1)
	CXXFLAGS += -DVERBOSE
endif

# Randomness
ifeq ($(STOCHASTIC),1)
	CXXFLAGS += -DSTOCHASTIC
endif

# Dryrun
ifeq ($(DRYRUN),1)
	CXXFLAGS += -DDRYRUN
else
	CXXFLAGS += -I/opt/cray/pe/hdf5/1.14.3.1/gnu/12.3/include
	LDFLAGS += -L/opt/cray/pe/hdf5/1.14.3.1/gnu/12.3/lib -lhdf5_cpp -lhdf5
endif

# Debug
ifeq ($(DEBUG),1)
	CXXFLAGS += -g
endif

# Outputs
MAIN_EXE     := main

