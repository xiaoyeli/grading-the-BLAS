
ARCH_STR = x86_64_zen3
COMPILER_STR = GNU_13.2

DGEMM_IMPLEMENTATIONS := 
DGEMM_IMPLEMENTATIONS += NETLIBBLAS
DGEMM_IMPLEMENTATIONS += BLIS
DGEMM_IMPLEMENTATIONS += OPENBLAS
DGEMM_IMPLEMENTATIONS += CUBLAS
DGEMM_IMPLEMENTATIONS += OZIMMU
DGEMM_IMPLEMENTATIONS += STRASSEN
DGEMM_IMPLEMENTATIONS += NAIVE_TRIPLE_LOOP_FP64
DGEMM_IMPLEMENTATIONS += NAIVE_TRIPLE_LOOP_EXTENDED_PRECISION

DGEMM_IMPL ?= NETLIBBLAS

# Directories
SRC_DIR := src
INC_DIR := include
LIB_DIR := lib

# Flags
CXXFLAGS := -O0 -I$(INC_DIR) -I/opt/cray/pe/hdf5/1.14.3.1/gnu/12.3/include
LDFLAGS := -L/opt/cray/pe/hdf5/1.14.3.1/gnu/12.3/lib -lhdf5_cpp -lhdf5

# Compiler
ifneq ($(filter $(DGEMM_IMPL), OZIMMU CUBLAS),)
	CXX := nvcc
else
	CXX := g++
endif

# Verbosity
ifeq ($(VERBOSE),1)
	CXXFLAGS += -DVERBOSE
endif

# Randomness
ifeq ($(STOCHASTIC),1)
	CXXFLAGS += -DSTOCHASTIC
endif

# Dryrun
ifeq ($(DRYRUN),1)
	CXXFLAGS += -DDRYRUN
endif

# Debug
ifeq ($(DEBUG),1)
	CXXFLAGS += -g
endif

# Outputs
MAIN_EXE     := main
STRASSEN_SO  := libstrassen_dgemm.so
NAIVE_TRIPLE_LOOP_SO := libnaive_triple_loop_gemm.so

########################################
ifeq ($(DGEMM_IMPL),NAIVE_TRIPLE_LOOP_FP64)
	VERSION_STR = 89e4cab
	COMPILER_STR = GNU_13.2
	FLAG_STR = O0
	DGEMM_IMPL_STR := $(DGEMM_IMPL)-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
	CXXFLAGS += -DDGEMM_IMPL=\"$(DGEMM_IMPL_STR)\"

	LDFLAGS +=  -L$(LIB_DIR) -lnaive_triple_loop_gemm
    RUN_PREFIX := LD_LIBRARY_PATH=$(LD_LIBRARY_PATH):$(LIB_DIR)
endif

ifeq ($(DGEMM_IMPL),NAIVE_TRIPLE_LOOP_EXTENDED_PRECISION)
	VERSION_STR = 89e4cab
	COMPILER_STR = GNU_13.2
	FLAG_STR = O0
	DGEMM_IMPL_STR := $(DGEMM_IMPL)-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
	CXXFLAGS += -DDGEMM_IMPL=\"$(DGEMM_IMPL_STR)\" -DEXTENDED_PRECISION_REFERENCE

	LDFLAGS +=  -L$(LIB_DIR) -lnaive_triple_loop_gemm
    RUN_PREFIX := LD_LIBRARY_PATH=$(LD_LIBRARY_PATH):$(LIB_DIR)
endif

ifeq ($(DGEMM_IMPL),NETLIBBLAS)
	VERSION_STR = 3.12.1
	COMPILER_STR = GNU_13.2
	FLAG_STR = DEFAULT
	DGEMM_IMPL_STR := $(DGEMM_IMPL)-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
	CXXFLAGS += -DDGEMM_IMPL=\"$(DGEMM_IMPL_STR)\"

	LDFLAGS += -lrefblas
    RUN_PREFIX :=
endif

ifeq ($(DGEMM_IMPL),BLIS)
	VERSION_STR = 2.0
	COMPILER_STR = GNU_13.2
	FLAG_STR = DEFAULT
	DGEMM_IMPL_STR := $(DGEMM_IMPL)-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
	CXXFLAGS += -DDGEMM_IMPL=\"$(DGEMM_IMPL_STR)\"

    LDFLAGS += -lblis
    RUN_PREFIX :=
endif

ifeq ($(DGEMM_IMPL),OPENBLAS)
	VERSION_STR = 0.3.30
	COMPILER_STR = GNU_13.2
	FLAG_STR = DEFAULT
	DGEMM_IMPL_STR := $(DGEMM_IMPL)-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
	CXXFLAGS += -DDGEMM_IMPL=\"$(DGEMM_IMPL_STR)\"
	
	LDFLAGS += -lopenblas
    RUN_PREFIX :=
endif

ifeq ($(DGEMM_IMPL),STRASSEN)
	VERSION_STR = 57e69bd
	COMPILER_STR = GNU_13.2
	FLAG_STR = O0
	ADDTL_PARAMS = BASECASE_2
	DGEMM_IMPL_STR := $(DGEMM_IMPL)_$(ADDTL_PARAMS)-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
	CXXFLAGS += -DDGEMM_IMPL=\"$(DGEMM_IMPL_STR)\"

    LDFLAGS += -L$(LIB_DIR) -lstrassen_dgemm
    RUN_PREFIX := LD_LIBRARY_PATH=$(LD_LIBRARY_PATH):$(LIB_DIR)
endif

ifeq ($(DGEMM_IMPL),CUBLAS)
	VERSION_STR = 12.9
# 	VERSION_STR = 13.0
	COMPILER_STR = unknown
	FLAG_STR = unknown
	ARCH_STR = NVCC8.0
	DGEMM_IMPL_STR := $(DGEMM_IMPL)-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
# 	DGEMM_IMPL_STR := $(DGEMM_IMPL)_fixed_mantissa_55-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
# 	DGEMM_IMPL_STR := $(DGEMM_IMPL)_fixed_mantissa_23-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
# 	DGEMM_IMPL_STR := $(DGEMM_IMPL)_fixed_mantissa_7-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
# 	DGEMM_IMPL_STR := $(DGEMM_IMPL)_no_emulation-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
# 	DGEMM_IMPL_STR := $(DGEMM_IMPL)_eager_strat-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
	CXXFLAGS += -DDGEMM_IMPL=\"$(DGEMM_IMPL_STR)\"

	CXXFLAGS += -DCUDA
    LDFLAGS += -lcublas
	RUN_PREFIX :=
# 	RUN_PREFIX := CUBLAS_FIXEDPOINT_EMULATION_MANTISSA_BIT_COUNT=55
# 	RUN_PREFIX := CUBLAS_FIXEDPOINT_EMULATION_MANTISSA_BIT_COUNT=23
# 	RUN_PREFIX := CUBLAS_FIXEDPOINT_EMULATION_MANTISSA_BIT_COUNT=7
# 	RUN_PREFIX := CUBLAS_EMULATE_DOUBLE_PRECISION=0
#   RUN_PREFIX := CUBLAS_EMULATION_STRATEGY=eager
endif

ifeq ($(DGEMM_IMPL),OZIMMU)
	VERSION_STR = 08eea92
	COMPILER_STR = GNU_13.2+NVCC_12.9
	FLAG_STR = DEFAULT
	ARCH_STR = NVCC8.0
	ADDTL_PARAMS = AUTO_THRESH0
	DGEMM_IMPL_STR := $(DGEMM_IMPL)_$(ADDTL_PARAMS)-$(VERSION_STR)-$(COMPILER_STR)-$(FLAG_STR)-$(ARCH_STR)
	CXXFLAGS += -DDGEMM_IMPL=\"$(DGEMM_IMPL_STR)\"

	CXXFLAGS += -DCUDA
    LDFLAGS += -lcublas
	RUN_PREFIX := OZIMMU_COMPUTE_MODE=fp64_int8_auto
	RUN_PREFIX += OZIMMU_AUTO_AVG_MANTISSA_LOSS_THRESHOLD=0
	RUN_PREFIX += OZIMMU_INTERCEPT_THRESHOLD_M=2
	RUN_PREFIX += OZIMMU_INTERCEPT_THRESHOLD_N=2
	RUN_PREFIX += OZIMMU_INTERCEPT_THRESHOLD_K=2
    RUN_PREFIX += LD_PRELOAD=$(OZIMMU_SO_PATH)
endif
########################################

all: dirs $(LIB_DIR)/$(STRASSEN_SO) $(LIB_DIR)/$(NAIVE_TRIPLE_LOOP_SO) $(MAIN_EXE)

$(LIB_DIR)/$(STRASSEN_SO): $(SRC_DIR)/strassen_dgemm.cpp
	g++ -O0 -fPIC -shared -Iinclude $< -o $@

$(LIB_DIR)/$(NAIVE_TRIPLE_LOOP_SO): $(SRC_DIR)/naive_triple_loop_gemm.cpp
	g++ -O0 -fPIC -shared -Iinclude $< -o $@

$(MAIN_EXE): $(SRC_DIR)/main.cpp
	$(CXX) $(CXXFLAGS) $< $(LDFLAGS) -o $@

dirs:
	@mkdir -p $(LIB_DIR)

run: all
	$(RUN_PREFIX) ./$(MAIN_EXE)

run_all:
	@for implementation in $(DGEMM_IMPLEMENTATIONS); do \
		echo ""; \
		echo "=== Building and running $$implementation ==="; \
		$(MAKE) $(MAKEFLAGS) DGEMM_IMPL=$$implementation run; \
	done

###########################################
# Cleanup
###########################################
clean:
	rm -rf $(MAIN_EXE) $(LIB_DIR)

.PHONY: all dirs clean run run_all_tests $(MAIN_EXE)
