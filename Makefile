########################################

setup: dirs libs

dirs:
	@mkdir -p $(LIB_DIR) $(BIN_DIR)

libs:
	$(MAKE) -C $(SRC_DIR) -f Makefile.libs

$(MAIN_EXE): $(SRC_DIR)/main.cpp
	$(CXX) $(CXXFLAGS) $< $(LDFLAGS) -o $(BIN_DIR)/$@

run: $(MAIN_EXE) setup
	$(RUN_PREFIX) ./$(BIN_DIR)/$(MAIN_EXE)

###########################################
# Cleanup
###########################################
clean:
	rm -rf $(BIN_DIR) $(LIB_DIR)

.PHONY: setup clean run $(MAIN_EXE)
