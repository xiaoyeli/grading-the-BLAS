#!/bin/bash
# config.sh — fill in your DGEMM implementation details
# Copy this file to config.sh and edit the values below.

# === target DGEMM implementation ===
DGEMM_IMPL_NAME="OPENBLAS_0.3.30_GNU_13.2_DEFAULT_x86_64_zen3"
SO_PATH="/global/u2/j/jvanover/grading-the-blas/submodules/OpenBLAS-0.3.30/libopenblas.so"
LDFLAGS="-lopenblas"
RUN_PREFIX=""               # optional; string prepended to execution command, i.e., "${RUN_PREFIX} ./run_test"

# === test parameters ===
LOG2_MIN_DIM=${1}             # MIN_DIM = 2^LOG2_MIN_DIM
LOG2_MAX_DIM=${2}             # MAX_DIM = 2^LOG2_MAX_DIM
LOG2_MIN_SCALING_FACTOR=${3}  # MIN_SCALING_FACTOR = 2^LOG2_MIN_SCALING_FACTOR
LOG2_MAX_SCALING_FACTOR=${4}  # MAX_SCALING_FACTOR = 2^LOG2_MAX_SCALING_FACTOR
LOG2_INC_SCALING_FACTOR=${5}  # INC_SCALING_FACTOR = 2^LOG2_INC_SCALING_FACTOR (must be positive nonzero)
INPUT_TYPE=${6}

# === advanced options ===
VERBOSE=0           # when VERBOSE=1, prints A, B, and C to stdout

OUTER_PERMUTE=${7}  # for OUTER_PERMUTE=n: Perform n trials of P1_inv * ( (P1 * A) * (B * P2) ) * P2_inv
                    # with random P1 and P2. The value of REFERENCE_GEMM is
                    # ignored and the maximum componentwise error with respect
                    # to A * B using the implementation under test over the n
                    # trials is reported

INNER_PERMUTE=${8}  # for INNER_PERMUTE=n: Perform n trials of (A * P) * (P * B)
                    # with random P. The value of REFERENCE_GEMM is
                    # ignored and the maximum componentwise error with respect
                    # to A * B using the implementation under test over the n
                    # trials is reported

OUTER_SCALING=${9}  # when OUTER_SCALING=1, calculate D1_inv * ( (D1 * A) * (B * D2) ) * D2_inv
                    # where, respectively, D1 and D2 yield rows and cols of A and B with unit norms

INNER_SCALING=${10} # when INNER_SCALING=1, calculate (A * D) * (D_inv * B)
                    # where D yields cols and rows of A and B respectively with roughly equal norms

DUMP_A_B=0          # when DUMP_A_B=1, dump the input matrices

DUMP_C=${11}        # when DUMP_C=1, dump the output matrices

REFERENCE_GEMM=2    # 1 - Reference is a naive triple loop GEMM in double precision
                    # 2 - Reference is a naive triple loop GEMM in long double precision

# === compilation tweaks ====
CXX="g++"
USE_CUDA=0      # if USE_CUDA=1, set CXX=nvcc
CXXFLAGS=""     # optional