LIB_DIR 	 := ../lib

# Outputs
MAIN_EXE     := main

STRASSEN_SO  := libstrassen_dgemm.so
STRASSEN_ADDB_SCALING_SO  := libstrassen_addb_scaling_dgemm.so
STRASSEN_DABD_SCALING_SO  := libstrassen_dabd_scaling_dgemm.so
STRASSEN_DABD_SCALING_AND_ZEROING_SO  := libstrassen_dabd_scaling_and_zeroing_dgemm.so
NAIVE_TRIPLE_LOOP_SO := libnaive_triple_loop_gemm.so

ALL_LIBS := $(LIB_DIR)/$(STRASSEN_SO) \
            $(LIB_DIR)/$(STRASSEN_ADDB_SCALING_SO) \
            $(LIB_DIR)/$(STRASSEN_DABD_SCALING_SO) \
            $(LIB_DIR)/$(STRASSEN_DABD_SCALING_AND_ZEROING_SO) \
            $(LIB_DIR)/$(NAIVE_TRIPLE_LOOP_SO)

all: $(ALL_LIBS)

$(LIB_DIR)/$(STRASSEN_SO): strassen_dgemm.cpp
	g++ -O0 -fPIC -shared $< -o $@

$(LIB_DIR)/$(STRASSEN_ADDB_SCALING_SO): strassen_dgemm.cpp
	g++ -O0 -fPIC -DADDB_SCALING -shared $< -o $@

$(LIB_DIR)/$(STRASSEN_DABD_SCALING_SO): strassen_dgemm.cpp
	g++ -O0 -fPIC -DDABD_SCALING -shared $< -o $@

$(LIB_DIR)/$(STRASSEN_DABD_SCALING_AND_ZEROING_SO): strassen_dgemm.cpp
	g++ -O0 -fPIC -DDABD_SCALING -DZEROING -shared $< -o $@

$(LIB_DIR)/$(NAIVE_TRIPLE_LOOP_SO): naive_triple_loop_gemm.cpp
	g++ -O0 -fPIC -shared $< -o $@

.PHONY: all